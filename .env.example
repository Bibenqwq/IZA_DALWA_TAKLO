# ==========================================================
# iza.dalawa.taklo — Environment Variables Example
# ==========================================================
# By default, the application runs in Local-First Persistent Mode
# using browser IndexedDB and localStorage with automatic draft recovery.
#
# If deploying to production with Supabase for multi-device sync,
# configure the following keys:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Admin master passkey for authentication
VITE_ADMIN_DEFAULT_PIN=1234
